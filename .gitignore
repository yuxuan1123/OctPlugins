# OS
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 日志
*.log
logs/

# 环境 / 密钥
.env
.env.*
*.local
*.pem
*.key

# Node（宿主）
node_modules/
ui/node_modules/
kernel/node_modules/
npm-debug.log*

# 构建产物
dist/
build/
ui/build/
kernel/bin/
kernel/kerneld
kernel/kerneld.exe

# Python（SDK 与依赖运行时）
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage

# Go（内核）
kernel/internal/deps/
*.out

# 运行态：项目生成/可写目录（各插件本地缓存、依赖隔离环境）
state/
config/
runtime/
# 例外（重要）：上面的 `config/`、`runtime/` 是不带斜杠前缀的通配规则，会连带把
# 内核里的同名 **Go 包**一起忽略 —— kernel/internal/config 与 kernel/internal/runtime
# 曾经因此从未入库，导致换机/克隆后内核编译失败（undefined: config.SchemaProps 等）。
# 这里显式放行这两个包目录（否定规则须写在忽略规则之后）。
!kernel/internal/config/
!kernel/internal/runtime/
# 插件配置目录：含 CHECKIN_TOKEN 等凭据，禁止入库
store/
*.tmp

# 用户插件目录：一律不入库（第三方/本地安装均排除）
/plugins/
mvp_test/
# 备份文件
*.bak